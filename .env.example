# Supabase Configuration
# To get these values:
# 1. Go to https://app.supabase.com
# 2. Select your project
# 3. Go to Project Settings > API
# 4. Copy the URL and anon/public key

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT: After setting these values:
# 1. Make sure your Supabase database tables are created
#    - Go to Supabase SQL Editor
#    - Run the SQL from supabase/migrations/0001_initial_schema.sql
# 2. Check Row Level Security (RLS) is disabled or properly configured
# 3. Restart your development server

# To test your connection, check the browser console
# You should see: "✓ Supabase connection successful"